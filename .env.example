# Copy this file to .env and fill in your own keys. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
WEATHERAPI_KEY=
TAVILY_API_KEY=

MB_API_KEY=                    # Travezy's backend sends this as X-API-Key; the service refuses requests without it
POSTGRES_PASSWORD=             # required, no default; production reads it from secrets

# Optional
MB_KILL_SWITCH=0               # 1 stops all new briefs at once (API returns 503, batch skips)
MB_FX=live                     # live exchange rates for the spend line; "fixed" uses config/fx.yaml (tests, evaluation)
